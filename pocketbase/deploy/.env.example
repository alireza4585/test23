# Public domain pointing at this server (A record). Caddy obtains TLS for it.
ZH_DOMAIN=api.example.ir

# Shared HMAC secret with n8n (both directions). Generate: openssl rand -hex 32
ZH_INTEGRATION_SECRET=
# n8n webhook that receives platform events (leave empty to disable).
ZH_N8N_WEBHOOK_URL=
# Also queue push-notification requests for n8n (1 = on).
ZH_PUSH_VIA_N8N=0

# AI assistant: none (rule-based answers) | anthropic | openai_compatible
ZH_AI_PROVIDER=none
ZH_AI_API_KEY=
ZH_AI_MODEL=
# openai_compatible only, e.g. a self-hosted Ollama/vLLM: http://llm.internal:11434
ZH_AI_BASE_URL=
