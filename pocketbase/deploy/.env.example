# Public domain pointing at this server (A record). Caddy obtains TLS for it.
ZH_DOMAIN=api.example.ir

# Shared HMAC secret with n8n (both directions). Generate: openssl rand -hex 32
ZH_INTEGRATION_SECRET=
# n8n webhook that receives platform events (leave empty to disable).
ZH_N8N_WEBHOOK_URL=
# Also queue push-notification requests for n8n (1 = on).
ZH_PUSH_VIA_N8N=0

# Set to false once every caller (n8n, the AI worker) signs with a scoped key.
ZH_ALLOW_SHARED_SECRET=true
# 32 characters; encrypts the scoped integration keys (integrationKeys).
# Generate: openssl rand -hex 16   (never change it after keys exist)
ZH_SECRETS_KEY=

# AI assistant: none (rule-based answers) | openai_compatible | anthropic
ZH_AI_PROVIDER=none
ZH_AI_API_KEY=
# Required for any provider; there is no built-in default model.
ZH_AI_MODEL=
# openai_compatible: Liara AI / a gateway / self-hosted vLLM or Ollama.
# With or without the /v1 suffix, e.g. https://<gateway>/api/v1 or http://llm.internal:11434
ZH_AI_BASE_URL=
# Optional limits (defaults in brackets)
ZH_AI_MAX_TOKENS=          # [1024] assistant answer; the morning narrative uses at most 800
ZH_AI_TIMEOUT_SECONDS=     # [45]
ZH_AI_MONTHLY_BUDGET_TOKENS=   # [2000000] per hotel; hotels.settings.ai.monthlyTokenBudget overrides
ZH_AI_RETENTION_DAYS=      # [90] assistant conversations
ZH_AI_PRICE_IN_PER_MTOK=   # USD per million input tokens, for the cost figures (0 = unknown)
ZH_AI_PRICE_OUT_PER_MTOK=

# Daily temperature for the energy models (AI phase 1, F2): none | open_meteo | nasa_power.
# Keep none until the weather probe has shown which source this server can reach.
# Coordinates per hotel: hotels.settings.location = {"lat": …, "lon": …}.
ZH_WEATHER_PROVIDER=none
# Optional base URL override (a mirror); empty = the provider's public URL.
ZH_WEATHER_BASE_URL=
