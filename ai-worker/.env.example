# Zarin AI worker — placeholders only. On Liara set these in the app's
# environment panel; locally export them in your own terminal.

# PocketBase integration API and the worker's scoped key
# (create it with `npm run integration-key` in pocketbase/; the secret is shown once)
ZH_PB_URL=https://<pocketbase-app>.liara.run
ZH_WORKER_KEY_ID=
ZH_WORKER_SECRET=
# Hotels this worker serves (comma-separated ids); the key must cover them
ZH_WORKER_HOTEL_IDS=

# Signs job triggers from n8n / PocketBase (POST /jobs/{name}). openssl rand -hex 32
ZH_WORKER_TRIGGER_SECRET=
ZH_WORKER_DB=/data/worker.db
ZH_WORKER_POLL_SECONDS=5

# LLM gateway: openai_compatible | mock | none
ZH_LLM_PROVIDER=openai_compatible
# Liara AI (OpenAI-compatible) base URL from the Liara panel, with or without /v1
ZH_LLM_BASE_URL=
ZH_LLM_API_KEY=
ZH_LLM_MODEL=
# Optional second model/provider used when the first fails or times out
ZH_LLM_FALLBACK_MODEL=
ZH_LLM_FALLBACK_BASE_URL=
ZH_LLM_FALLBACK_API_KEY=
ZH_LLM_TIMEOUT_SECONDS=30
ZH_LLM_MAX_TOKENS=800
# USD per million tokens, for the cost log (0 = unknown)
ZH_LLM_PRICE_IN_PER_MTOK=0
ZH_LLM_PRICE_OUT_PER_MTOK=0
ZH_LLM_COST_LOG=/data/cost-log.jsonl
