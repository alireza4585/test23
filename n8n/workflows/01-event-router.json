    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst icon = { critical: '🔴', warning: '🟠', info: '🔵' }[e.data.severity] || '•';\nreturn [{ json: { ...e, text: `${icon} ${e.data.title}\\n${e.data.message}\\nهتل: ${e.hotelId}` } }];"
      },
