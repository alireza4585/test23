    {
      "parameters": {
        "jsCode": "// Reject anything not signed by the Zarin backend (shared INTEGRATION_SECRET).\nconst crypto = require('crypto');\nconst item = $input.first().json;\nconst headers = item.headers || {};\nconst timestamp = Number(headers['x-zarin-timestamp']);\nconst signature = String(headers['x-zarin-signature'] || '');\nconst raw = JSON.stringify(item.body);\nconst expected = crypto.createHmac('sha256', $env.ZARIN_INTEGRATION_SECRET).update(`${timestamp}.${raw}`).digest('hex');\nconst fresh = Number.isFinite(timestamp) && Math.abs(Date.now() / 1000 - timestamp) < 300;\nconst valid = signature.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(signature, 'hex'), Buffer.from(expected, 'hex'));\nif (!fresh || !valid) throw new Error('Invalid or stale Zarin signature');\nreturn [{ json: item.body }];"
      },
      "id": "ee720016-24aa-5586-85cd-2d7517942fc6",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
