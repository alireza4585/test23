      },
      "id": "cf10c14a-0845-42b6-8a4d-4c76db2f6743",
      "name": "SMS configured? · maintenance",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        400
      ],
      "notes": "Skips this channel while KAVENEGAR_API_KEY or MAINTENANCE_MANAGER_MOBILE is empty."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.kavenegar.com/v1/{{ $env.KAVENEGAR_API_KEY }}/sms/send.json",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "receptor",
              "value": "={{ $env.MAINTENANCE_MANAGER_MOBILE }}"
            },
            {
              "name": "message",
              "value": "={{ $json.smsText }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "c64b1ac5-2ade-58ff-a5ff-fdcf5a15c184",
      "name": "SMS · maintenance manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        400
      ]
    }
  ],
