# --- n8n itself -----------------------------------------------------------
N8N_DB_PASSWORD=change-me
# openssl rand -hex 32  (keep it: credentials are encrypted with it)
N8N_ENCRYPTION_KEY=
# Public HTTPS origin of this n8n instance, e.g. https://automation.example.ir/
N8N_PUBLIC_URL=

# --- Zarin platform ---------------------------------------------------------
# Same value as the backend secret: PocketBase ZH_INTEGRATION_SECRET or the
# Firebase INTEGRATION_SECRET (used in both directions).
ZARIN_INTEGRATION_SECRET=
# Base URL of the platform API: the PocketBase server (https://api.example.ir)
# or the Firebase `api` function (https://europe-west3-<project>.cloudfunctions.net/api).
ZARIN_API_BASE=
# Comma-separated hotel ids for scheduled workflows.
ZARIN_HOTEL_IDS=zarintehran0001

# --- Bale messenger (bot API) -------------------------------------------------
BALE_BOT_TOKEN=
BALE_MANAGEMENT_CHAT_ID=
BALE_MAINTENANCE_CHAT_ID=
BALE_ENERGY_CHAT_ID=

# --- SMS (Kavenegar) ------------------------------------------------------------
KAVENEGAR_API_KEY=
ONCALL_MANAGER_MOBILE=
MAINTENANCE_MANAGER_MOBILE=

# --- E-mail -------------------------------------------------------------------
ZARIN_MAIL_FROM=no-reply@example.ir
ZARIN_REPORT_RECIPIENTS=gm@example.ir,owner@example.ir
PROCUREMENT_EMAIL=procurement@example.ir
