rules_version = '2';

// Zarin Hooshmand — Firestore Security Rules
//
// Principles
// * Tenant isolation: all operational data lives under hotels/{hotelId}; a
//   user may touch a hotel only if hotelId ∈ token.hotelIds (custom claim set
//   by Cloud Functions). superAdmin is the only cross-tenant role.
// * RBAC: token.role → permissions via permRoles() (generated from
//   functions/src/domain/rbac.ts, the same matrix the app uses for its UI).
// * Least privilege for front-line staff: they read only their own tasks /
//   shifts / tickets and may change only workflow fields, via the allowed
//   status transitions.
// * Integrity: actor stamps must match the caller, immutable ledgers
//   (inventory movements, ticket events, audit log), and server-only
//   collections (alerts, insights, metrics, audit, members, notifications)
//   are written exclusively by Cloud Functions (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function role() { return request.auth.token.role; }
    function isSuperAdmin() { return signedIn() && role() == 'superAdmin'; }

    function memberOf(hotelId) {
      return signedIn() && (
        isSuperAdmin() ||
        (request.auth.token.hotelIds is list && hotelId in request.auth.token.hotelIds)
      );
    }

    // <rbac:begin> generated from functions/src/domain/rbac.ts — run `npm run gen:rules`
    function permRoles() {
      return {
        'dashboard.executive': ['hotelOwner', 'generalManager', 'analyst'],
        'dashboard.operations': ['generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'housekeepingManager', 'restaurantManager', 'inventoryManager', 'hrManager'],
        'rooms.view': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'housekeepingManager', 'receptionStaff', 'housekeepingStaff', 'maintenanceStaff', 'analyst'],
        'rooms.updateStatus': ['generalManager', 'operationsManager', 'maintenanceManager', 'housekeepingManager', 'receptionStaff', 'housekeepingStaff'],
        'rooms.manage': ['generalManager', 'operationsManager'],
        'housekeeping.viewOwn': ['housekeepingStaff'],
        'housekeeping.viewAll': ['hotelOwner', 'generalManager', 'operationsManager', 'housekeepingManager', 'analyst'],
        'housekeeping.assign': ['generalManager', 'operationsManager', 'housekeepingManager'],
        'housekeeping.complete': ['housekeepingManager', 'housekeepingStaff'],
        'maintenance.report': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'housekeepingManager', 'restaurantManager', 'inventoryManager', 'hrManager', 'receptionStaff', 'housekeepingStaff', 'maintenanceStaff', 'restaurantStaff'],
        'maintenance.viewOwn': ['housekeepingManager', 'restaurantManager', 'inventoryManager', 'hrManager', 'receptionStaff', 'housekeepingStaff', 'maintenanceStaff', 'restaurantStaff'],
        'maintenance.viewAll': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'analyst'],
        'maintenance.manage': ['generalManager', 'operationsManager', 'maintenanceManager'],
        'maintenance.work': ['maintenanceManager', 'maintenanceStaff'],
        'energy.view': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'analyst'],
        'energy.record': ['generalManager', 'energyManager'],
        'inventory.view': ['hotelOwner', 'generalManager', 'operationsManager', 'maintenanceManager', 'housekeepingManager', 'restaurantManager', 'inventoryManager', 'restaurantStaff', 'analyst'],
        'inventory.move': ['generalManager', 'maintenanceManager', 'housekeepingManager', 'restaurantManager', 'inventoryManager'],
        'inventory.manage': ['generalManager', 'inventoryManager'],
        'staff.viewOwnShifts': ['receptionStaff', 'housekeepingStaff', 'maintenanceStaff', 'restaurantStaff'],
        'staff.view': ['hotelOwner', 'generalManager', 'operationsManager', 'maintenanceManager', 'housekeepingManager', 'restaurantManager', 'hrManager', 'analyst'],
        'staff.manage': ['generalManager', 'operationsManager', 'hrManager'],
        'operations.recordDaily': ['generalManager', 'operationsManager', 'receptionStaff'],
        'finance.view': ['hotelOwner', 'generalManager', 'analyst'],
        'reports.view': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'housekeepingManager', 'restaurantManager', 'inventoryManager', 'hrManager', 'analyst'],
        'reports.generate': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'inventoryManager', 'analyst'],
        'notifications.view': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'housekeepingManager', 'restaurantManager', 'inventoryManager', 'hrManager', 'receptionStaff', 'housekeepingStaff', 'maintenanceStaff', 'restaurantStaff', 'analyst'],
        'ai.insights.view': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'maintenanceManager', 'housekeepingManager', 'restaurantManager', 'inventoryManager', 'analyst'],
        'ai.assistant.use': ['hotelOwner', 'generalManager', 'operationsManager', 'energyManager', 'analyst'],
        'users.manage': ['hotelOwner', 'generalManager', 'hrManager'],
        'audit.view': ['hotelOwner', 'generalManager'],
        'hotel.settings': ['hotelOwner', 'generalManager']
      };
    }

    function roomTransitions() {
      return {
        'housekeepingStaff': {'vacantDirty': ['cleaningInProgress'], 'cleaningInProgress': ['vacantClean']},
        'housekeepingManager': {'vacantDirty': ['cleaningInProgress', 'vacantClean'], 'cleaningInProgress': ['vacantClean', 'vacantDirty'], 'vacantClean': ['vacantDirty'], 'outOfOrder': ['vacantDirty']},
        'receptionStaff': {'vacantClean': ['occupied'], 'occupied': ['vacantDirty']},
        'maintenanceManager': {'vacantClean': ['outOfOrder'], 'vacantDirty': ['outOfOrder'], 'outOfOrder': ['vacantDirty']}
      };
    }
    // <rbac:end>

    function hasPerm(perm) { return isSuperAdmin() || role() in permRoles()[perm]; }
    function can(hotelId, perm) { return memberOf(hotelId) && hasPerm(perm); }
    function can2(hotelId, a, b) { return can(hotelId, a) || can(hotelId, b); }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return incoming().diff(existing()).affectedKeys(); }
    function onlyChanges(keys) { return changedKeys().hasOnly(keys); }
    function stampedBy(field) {
      return incoming()[field] is map && incoming()[field].uid == uid();
    }
    function isDayKey(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function nonNegative(v) { return (v is int || v is float) && v >= 0; }

    // Each $(…) interpolates exactly one path segment.
    function hotelDoc(hotelId, col, id) {
      return /databases/$(database)/documents/hotels/$(hotelId)/$(col)/$(id);
    }

    // ------------------------------------------------------ global catalogs
    match /permissions/{code} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /roleTemplates/{roleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isSuperAdmin());
      // Created / provisioned only by Cloud Functions. The owner may clear
      // the temporary-password flag after changing the password.
      allow update: if signedIn() && userId == uid()
        && onlyChanges(['mustChangePassword', 'passwordChangedAt', 'locale'])
        && (!('mustChangePassword' in changedKeys()) || incoming().mustChangePassword == false);
      allow create, delete: if false;

      match /sessions/{deviceId} {
        allow read: if signedIn() && userId == uid();
        // Registration goes through `authRegisterSession`; the device may
        // only end its own session (sign-out) or refresh its push token.
        allow update: if signedIn() && userId == uid()
          && onlyChanges(['revokedAt', 'pushToken', 'lastSeenAt']);
        allow create: if signedIn() && userId == uid()
          && incoming().keys().hasOnly(['revokedAt', 'pushToken']);
        allow delete: if false;
      }

      match /inbox/{notificationId} {
        allow read: if signedIn() && userId == uid();
        allow update: if signedIn() && userId == uid() && onlyChanges(['readAt']);
        allow delete: if signedIn() && userId == uid();
        allow create: if false;
      }

      match /usage/{doc} {
        allow read, write: if false;
      }
    }

    // ------------------------------------------------------------- hotels
    match /hotels/{hotelId} {
      allow read: if memberOf(hotelId);
      allow update: if can(hotelId, 'hotel.settings') && onlyChanges(['settings', 'updatedAt', 'updatedBy']);
      allow create, delete: if isSuperAdmin();

      // Hotel user directory — written by Cloud Functions only.
      match /members/{memberId} {
        allow read: if can(hotelId, 'users.manage') || (memberOf(hotelId) && memberId == uid());
        allow write: if false;
      }

      match /roleOverrides/{roleId} {
        allow read: if memberOf(hotelId);
        allow write: if isSuperAdmin();
      }

      // ------------------------------------------------------------ rooms
      match /rooms/{roomId} {
        allow read: if can(hotelId, 'rooms.view');
        allow create, delete: if can(hotelId, 'rooms.manage');
        allow update: if can(hotelId, 'rooms.manage') || (
          can(hotelId, 'rooms.updateStatus')
          && onlyChanges(['status', 'previousStatus', 'updatedAt', 'updatedBy', 'updatedByName', 'note'])
          && stampedBy('updatedBy')
          && incoming().previousStatus == existing().status
          && role() in roomTransitions()
          && existing().status in roomTransitions()[role()]
          && incoming().status in roomTransitions()[role()][existing().status]
        );
      }

      // ---------------------------------------------- housekeeping tasks
      match /tasks/{taskId} {
        allow read: if can(hotelId, 'housekeeping.viewAll')
          || (can(hotelId, 'housekeeping.viewOwn') && existing().assigneeId == uid());
        allow create: if can(hotelId, 'housekeeping.assign')
          && incoming().kind == 'housekeeping'
          && incoming().status == 'pending'
          && isDayKey(incoming().day)
          && stampedBy('createdBy');
        allow update: if can(hotelId, 'housekeeping.assign') || (
          can(hotelId, 'housekeeping.complete')
          && existing().assigneeId == uid()
          && onlyChanges(['status', 'startedAt', 'completedAt', 'notes', 'updatedAt', 'updatedBy'])
          && stampedBy('updatedBy')
          && (
            (existing().status == 'pending' && incoming().status == 'inProgress'
              && incoming().startedAt == request.time)
            || (existing().status == 'inProgress' && incoming().status == 'done'
              && incoming().completedAt == request.time)
          )
        );
        allow delete: if can(hotelId, 'housekeeping.assign');
      }

      // ------------------------------------------------------ maintenance
      match /maintenanceTickets/{ticketId} {
        allow read: if can(hotelId, 'maintenance.viewAll')
          || (memberOf(hotelId) && (existing().reportedById == uid() || existing().assigneeId == uid()));
        allow create: if can(hotelId, 'maintenance.report')
          && incoming().reportedById == uid()
          && incoming().status == 'open'
          && incoming().priority in ['low', 'medium', 'high', 'critical']
          && incoming().category in ['hvac', 'electrical', 'plumbing', 'furniture', 'appliance', 'itNetwork', 'structural', 'other']
          && incoming().title is string && incoming().title.size() >= 3 && incoming().title.size() <= 200
          && incoming().photoPaths is list && incoming().photoPaths.size() <= 6
          && !('assigneeId' in incoming())
          && incoming().createdAt == request.time;
        allow update: if can(hotelId, 'maintenance.manage') || (
          can(hotelId, 'maintenance.work')
          && existing().assigneeId == uid()
          && onlyChanges(['status', 'updatedAt', 'updatedBy', 'resolvedAt', 'resolutionNote'])
          && stampedBy('updatedBy')
          && (
            (existing().status in ['open', 'assigned'] && incoming().status == 'inProgress')
            || (existing().status == 'inProgress' && incoming().status in ['onHold', 'resolved'])
            || (existing().status == 'onHold' && incoming().status == 'inProgress')
            || (existing().status == 'resolved' && incoming().status == 'inProgress')
          )
        );
        allow delete: if isSuperAdmin();

        // Immutable timeline.
        match /events/{eventId} {
          allow read: if can(hotelId, 'maintenance.viewAll') || (
            memberOf(hotelId) && (
              get(hotelDoc(hotelId, 'maintenanceTickets', ticketId)).data.reportedById == uid()
              || get(hotelDoc(hotelId, 'maintenanceTickets', ticketId)).data.assigneeId == uid()
            )
          );
          allow create: if memberOf(hotelId)
            && stampedBy('actor')
            && incoming().at == request.time
            && existsAfter(hotelDoc(hotelId, 'maintenanceTickets', ticketId));
          allow update, delete: if false;
        }
      }

      // ----------------------------------------------------------- energy
      match /energyReadings/{readingId} {
        allow read: if can(hotelId, 'energy.view');
        allow create, update: if can(hotelId, 'energy.record')
          && incoming().type in ['electricity', 'water', 'gas']
          && readingId == incoming().day + '_' + incoming().type
          && isDayKey(incoming().day)
          && nonNegative(incoming().consumption) && incoming().consumption < 10000000
          && incoming().source == 'manual'
          && stampedBy('recordedBy');
        allow delete: if isSuperAdmin();
      }

      // -------------------------------------- daily occupancy & revenue
      match /dailyOperations/{day} {
        allow read: if can2(hotelId, 'finance.view', 'operations.recordDaily') || can2(hotelId, 'energy.view', 'dashboard.operations');
        allow write: if can(hotelId, 'operations.recordDaily')
          && day == incoming().day && isDayKey(day)
          && incoming().roomsOccupied is int && incoming().roomsAvailable is int
          && incoming().roomsOccupied >= 0 && incoming().roomsOccupied <= incoming().roomsAvailable
          && nonNegative(incoming().roomRevenue)
          && stampedBy('updatedBy');
      }

      // -------------------------------------------------------- inventory
      match /inventoryItems/{itemId} {
        allow read: if can(hotelId, 'inventory.view');
        allow create: if can(hotelId, 'inventory.manage') && nonNegative(incoming().quantity);
        // Quantity can only change together with a ledger entry that
        // explains it (written in the same transaction).
        allow update: if (can(hotelId, 'inventory.manage') || can(hotelId, 'inventory.move'))
          && (can(hotelId, 'inventory.manage')
              || onlyChanges(['quantity', 'lastMovementId', 'updatedAt', 'updatedBy']))
          && (!('quantity' in changedKeys()) || movementExplains(hotelId, itemId));
        allow delete: if can(hotelId, 'inventory.manage');

        function movementExplains(hotelId, itemId) {
          let mv = getAfter(hotelDoc(hotelId, 'inventoryMovements', incoming().lastMovementId)).data;
          return mv.itemId == itemId
            && mv.quantityBefore == existing().quantity
            && mv.quantityAfter == incoming().quantity
            && incoming().quantity >= 0;
        }
      }

      match /inventoryMovements/{movementId} {
        allow read: if can(hotelId, 'inventory.view');
        allow create: if can(hotelId, 'inventory.move')
          && stampedBy('actor')
          && incoming().type in ['receive', 'issue', 'adjust', 'waste']
          && incoming().quantityAfter == incoming().quantityBefore + incoming().delta
          && getAfter(hotelDoc(hotelId, 'inventoryItems', incoming().itemId)).data.lastMovementId == movementId;
        allow update, delete: if false;
      }

      // ---------------------------------------------------- staff & shifts
      match /staff/{staffId} {
        allow read: if can2(hotelId, 'staff.view', 'housekeeping.assign') || can(hotelId, 'maintenance.manage');
        allow write: if can(hotelId, 'staff.manage');
      }

      match /shifts/{shiftId} {
        allow read: if can(hotelId, 'staff.view')
          || (can(hotelId, 'staff.viewOwnShifts') && existing().userId == uid());
        allow create, update, delete: if can(hotelId, 'staff.manage');
      }

      // ------------------------------------------------- alerts & insights
      match /alerts/{alertId} {
        allow read: if memberOf(hotelId) && (isSuperAdmin() || role() in existing().audienceRoles);
        allow update: if memberOf(hotelId)
          && role() in existing().audienceRoles
          && onlyChanges(['status', 'acknowledgedBy', 'acknowledgedByName', 'acknowledgedAt'])
          && incoming().status == 'acknowledged'
          && stampedBy('acknowledgedBy');
        allow create, delete: if false;
      }

      match /aiInsights/{insightId} {
        allow read: if can(hotelId, 'ai.insights.view');
        allow update: if can2(hotelId, 'dashboard.executive', 'dashboard.operations')
          && onlyChanges(['status', 'updatedAt', 'updatedBy'])
          && incoming().status in ['accepted', 'dismissed', 'implemented']
          && stampedBy('updatedBy');
        allow create, delete: if false;
      }

      // ---------------------------------------------------------- reports
      match /reports/{reportId} {
        allow read: if can(hotelId, 'reports.view');
        allow create: if can(hotelId, 'reports.generate')
          && stampedBy('createdBy')
          && incoming().storagePath == 'hotels/' + hotelId + '/reports/' + reportId + '.pdf';
        allow update, delete: if false;
      }

      // ------------------------------------------------ server-only data
      match /dailyMetrics/{day} {
        allow read: if can2(hotelId, 'dashboard.executive', 'dashboard.operations') || can(hotelId, 'reports.view');
        allow write: if false;
      }
      match /notifications/{notificationId} {
        allow read: if can(hotelId, 'audit.view');
        allow write: if false;
      }
      match /auditLogs/{logId} {
        allow read: if can(hotelId, 'audit.view');
        allow write: if false;
      }
      match /aiConversations/{conversationId} {
        allow read: if can(hotelId, 'audit.view');
        allow write: if false;
      }
      match /integrations/{integrationId} {
        allow read, write: if false;
      }
    }

    // Everything else is denied by default.
  }
}
